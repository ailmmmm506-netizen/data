# rakez_riyadh_scraper.py
# Python 3.10+
import re
import time
from dataclasses import dataclass
from typing import List, Dict, Optional, Tuple
import requests
from bs4 import BeautifulSoup
import pandas as pd

BASE_CITY_URL = "https://rakez.sa/ar/%D9%85%D8%AF%D9%8A%D9%86%D8%A9/%D8%A7%D9%84%D8%B1%D9%8A%D8%A7%D8%B6/"
PAGE_URL_TMPL = BASE_CITY_URL.rstrip("/") + "/page/{}/"
UA = "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome Safari"

@dataclass
class Project:
    project_id: str
    project_title: str
    district: Optional[str]
    city: str
    type_: Optional[str]
    project_url: str

@dataclass
class UnitRow:
    project_id: str
    unit_ref: str
    status: str
    price_sar: Optional[float]
    bedrooms: Optional[int]
    area_m2: Optional[float]
    floor: Optional[str]

def clean_text(s: str) -> str:
    return re.sub(r"\s+", " ", (s or "").strip())

def parse_price(text: str) -> Optional[float]:
    # e.g. "1,526,000 ريال" or "1,490,000 SAR"
    t = text.replace("SAR", "").replace("ريال", "").replace("سعودي", "")
    t = t.replace(",", "").strip()
    m = re.search(r"(\d+(\.\d+)?)", t)
    return float(m.group(1)) if m else None

def parse_area(text: str) -> Optional[float]:
    # e.g. "261.43 م²"
    t = text.replace("م²", "").replace("m²", "").strip().replace(",", "")
    m = re.search(r"(\d+(\.\d+)?)", t)
    return float(m.group(1)) if m else None

def get_soup(url: str, session: requests.Session) -> BeautifulSoup:
    r = session.get(url, timeout=30, headers={"User-Agent": UA})
    r.raise_for_status()
    return BeautifulSoup(r.text, "html.parser")

def extract_project_links(city_page_soup: BeautifulSoup) -> List[str]:
    # WordPress style: project cards usually link to /ar/project/<id>/
    links = []
    for a in city_page_soup.select('a[href*="/ar/project/"]'):
        href = a.get("href")
        if href and href.startswith("http"):
            links.append(href)
        elif href:
            links.append("https://rakez.sa" + href)
    # unique preserving order
    seen = set()
    out = []
    for x in links:
        if x not in seen:
            seen.add(x)
            out.append(x)
    return out

def parse_project_id(url: str) -> str:
    m = re.search(r"/project/(\d+)/", url)
    return m.group(1) if m else url

def parse_project_header(soup: BeautifulSoup, url: str) -> Project:
    title = clean_text(soup.select_one("h1").get_text()) if soup.select_one("h1") else parse_project_id(url)
    # breadcrumbs / location tags often appear as linked terms near top
    # try to find district/city from first taxonomy line
    district = None
    city = "الرياض"
    tax = soup.select_one("a[href*='/ar/']")  # fallback
    # try common structure: tags like 【النرجس】, 【شمال الرياض】 in text, but in HTML: a tags in a taxonomy block
    tax_links = [clean_text(a.get_text()) for a in soup.select("a") if a.get("href", "").find("/ar/") >= 0]
    # heuristic: district often one of known حي names; keep first that isn't "شمال الرياض" "شرق الرياض" etc.
    directions = {"شمال الرياض","شرق الرياض","غرب الرياض","جنوب الرياض","وسط الرياض","شمال شرق الرياض","شمال غرب الرياض"}
    for t in tax_links[:10]:
        if t and t not in directions and t not in {"الرئيسية","مشاريع","الرياض"}:
            district = t
            break

    # project type: from "أنواع الوحدات" line in project info block
    type_ = None
    info_block = soup.get_text(" ", strip=True)
    m = re.search(r"أنواع الوحدات:\s*([^\s]+)", info_block)
    if m:
        type_ = m.group(1)

    return Project(
        project_id=parse_project_id(url),
        project_title=title,
        district=district,
        city=city,
        type_=type_,
        project_url=url
    )

def parse_units_table(soup: BeautifulSoup, project_id: str) -> List[UnitRow]:
    text = soup.get_text("\n", strip=True)

    # Units often appear as repeating blocks:
    # "#19 A" + status + price/reserved + "3 261.43 م² الدور الأرضي"
    lines = [clean_text(x) for x in text.split("\n") if clean_text(x)]
    units: List[UnitRow] = []

    i = 0
    while i < len(lines):
        if re.match(r"^#\S+", lines[i]):  # unit ref
            unit_ref = lines[i].replace("#", "").strip()
            # next lines: status then price or "محجوزة/محجوزة" etc.
            status = lines[i+1] if i+1 < len(lines) else ""
            price_line = lines[i+3] if i+3 < len(lines) else ""
            # sometimes price line equals status when reserved/sold
            price = None if ("محجوز" in price_line or "مباع" in price_line or "Reserved" in price_line or "Sold" in price_line) else parse_price(price_line)

            # find the line that contains bedrooms + area + floor (usually after price line)
            details_line = None
            for j in range(i, min(i+8, len(lines))):
                if ("م²" in lines[j] or "m²" in lines[j]) and re.search(r"\b\d+\b", lines[j]):
                    details_line = lines[j]
                    break

            bedrooms = None
            area = None
            floor = None
            if details_line:
                # e.g. "3 261.43 م² الدور الأرضي" or "3 155.62 m² First"
                nums = re.findall(r"\d+(\.\d+)?", details_line.replace(",", ""))
                if nums:
                    try:
                        bedrooms = int(float(nums[0]))
                    except:
                        bedrooms = None
                area = parse_area(details_line)
                # floor: remove numbers and area token
                floor = clean_text(re.sub(r"[\d\.,]+", " ", details_line).replace("م²","").replace("m²",""))

            units.append(UnitRow(
                project_id=project_id,
                unit_ref=unit_ref,
                status=status,
                price_sar=price,
                bedrooms=bedrooms,
                area_m2=area,
                floor=floor
            ))
        i += 1

    # De-dup
    seen = set()
    out = []
    for u in units:
        key = (u.project_id, u.unit_ref, u.floor, u.area_m2, u.price_sar, u.status)
        if key not in seen:
            seen.add(key)
            out.append(u)
    return out

def main():
    session = requests.Session()

    all_project_urls: List[str] = []
    page = 1
    while True:
        url = BASE_CITY_URL if page == 1 else PAGE_URL_TMPL.format(page)
        print(f"[+] Fetch city page {page}: {url}")
        soup = get_soup(url, session)
        project_urls = extract_project_links(soup)

        # If a page returns no project URLs, stop (likely end like page/8)
        if not project_urls:
            print(f"[!] No projects found on page {page}. Stop.")
            break

        # Append and continue
        for pu in project_urls:
            if pu not in all_project_urls:
                all_project_urls.append(pu)

        page += 1
        time.sleep(0.7)

    print(f"[+] Total unique project URLs: {len(all_project_urls)}")

    projects: List[Project] = []
    units: List[UnitRow] = []

    for idx, purl in enumerate(all_project_urls, start=1):
        pid = parse_project_id(purl)
        print(f"    ({idx}/{len(all_project_urls)}) Project {pid}: {purl}")
        soup = get_soup(purl, session)
        proj = parse_project_header(soup, purl)
        projects.append(proj)
        proj_units = parse_units_table(soup, proj.project_id)
        units.extend(proj_units)
        time.sleep(0.6)

    # DataFrames
    df_projects = pd.DataFrame([{
        "project_id": p.project_id,
        "project_title": p.project_title,
        "type": p.type_,
        "district": p.district,
        "city": p.city,
        "units_count": sum(1 for u in units if u.project_id == p.project_id),
        "project_url": p.project_url
    } for p in projects]).drop_duplicates(subset=["project_id"])

    df_units = pd.DataFrame([{
        "project_id": u.project_id,
        "unit_ref": u.unit_ref,
        "status": u.status,
        "price_sar": u.price_sar,
        "area_m2": u.area_m2,
        "bedrooms": u.bedrooms,
        "floor": u.floor
    } for u in units])

    summary = pd.DataFrame([{
        "extracted_at": pd.Timestamp.utcnow().strftime("%Y-%m-%d %H:%M UTC"),
        "city": "الرياض",
        "projects_included": int(df_projects["project_id"].nunique()),
        "units_included": int(len(df_units)),
        "notes": "Full Riyadh pages scraped until first empty page."
    }])

    out_xlsx = "rakez_riyadh_projects_units_FULL.xlsx"
    with pd.ExcelWriter(out_xlsx, engine="openpyxl") as writer:
        summary.to_excel(writer, sheet_name="Summary", index=False)
        df_projects.to_excel(writer, sheet_name="Projects", index=False)
        df_units.to_excel(writer, sheet_name="Units", index=False)

    print(f"[✅] Saved: {out_xlsx}")

if __name__ == "__main__":
    main()
